{
  "name": "polyglot-phonetic-judo",
  "version": "0.1.0",
  "description": "Deterministic phonetic pipeline that turns mangled ASR transcripts into canonical track titles. Hinglish / Bhojpuri / Spanglish / K-pop aware. Zero deps, zero ML, zero cost.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./catalog": "./dist/catalog.js"
  },
  "files": ["dist", "data", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --reporter=verbose test/perf.bench.ts"
  },
  "keywords": ["phonetics", "double-metaphone", "asr", "mcp", "alexa", "hinglish", "bhojpuri"],
  "author": "Kabir \"DHUN\" — THE YAP PATROL",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
