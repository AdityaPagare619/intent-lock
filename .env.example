# Optional — Gemini key for the orchestrator's host-brain extraction.
#
# To use it, export the variable in your shell before starting the demo
# (do NOT put a real key in this file, and never commit one):
#
#   export GEMINI_API_KEY="your-key-here"
#   make demo
#
# With a key set, the extraction helper calls the Gemini API directly
# with it. With NO key set, the demo still boots and locks: extraction
# falls back to the deterministic local floor plus the audited catalog
# snapshot, and the on-screen BrainStatus honestly shows the fallback.
#
# Optional overrides (defaults are measured and sane; most users need
# none of these):
#   GEMINI_MODEL=gemini-3.1-flash-lite  # pin a different primary model
#   GEMINI_EXTRACT_TIMEOUT_S=20         # per-attempt timeout (seconds)
#   GEMINI_EXTRACT_BUDGET_S=55          # whole-ladder budget (seconds)
GEMINI_API_KEY=
